          ]
        },
        {
          "name": "Get payout methods",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/payout/methods",
            "description": "Returns payout methods and database-controlled availability.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP response is successful', function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get payout options for selected method",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/payout/options/{{payoutMethod}}",
            "description": "Defaults to UPI. Returns active voucher options from MongoDB.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Options response is successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.options).to.be.an('array');",
                  "    if (data.options.length > 0) {",
                  "        pm.collectionVariables.set('payoutOptionId', data.options[0].optionId);",
                  "        pm.collectionVariables.set('payoutAmount', String(data.options[0].payoutAmount));",
                  "        pm.collectionVariables.set('requiredAmount', String(data.options[0].requiredAmount));",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create UPI withdrawal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/withdrawals",
            "description": "Uses the optionId from the previous request. The server looks up payoutAmount and required VES; do not send an amount. A unique GUID is generated for this request.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"{{payoutMethod}}\",\n  \"optionId\": \"{{payoutOptionId}}\",\n  \"payoutDetails\": {\n    \"upiId\": \"{{upiId}}\"\n  },\n  \"idempotencyKey\": \"{{$guid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Withdrawal request accepted', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.withdrawal).to.be.an('object');",
                  "    pm.collectionVariables.set('withdrawalId', data.withdrawal._id);",
                  "    pm.collectionVariables.set('lastWithdrawalStatus', data.withdrawal.status);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List my withdrawals",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/withdrawals?page=1&limit=20&status=all",
            "description": "Returns the current user withdrawal history.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP response is successful', function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my withdrawal by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/withdrawals/{{withdrawalId}}",
            "description": "Returns a withdrawal only if it belongs to the authenticated user.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP response is successful', function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel my pending withdrawal",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/withdrawals/{{withdrawalId}}/cancel",
            "description": "Cancels an eligible pending withdrawal and refunds VES with a credit ledger entry. Use only on a pending test withdrawal.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP response is successful', function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create withdrawal with fixed idempotency key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"{{payoutMethod}}\",\n  \"optionId\": \"{{payoutOptionId}}\",\n  \"payoutDetails\": {\n    \"upiId\": \"{{upiId}}\"\n  },\n  \"idempotencyKey\": \"{{duplicateIdempotencyKey}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/withdrawals",
            "description": "Run this once, then immediately run the next request. Keep the same fixed key in both requests. The backend should create one withdrawal."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('First idempotent request accepted', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('idempotentWithdrawalId', data.withdrawal._id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry exact same request with same key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"{{payoutMethod}}\",\n  \"optionId\": \"{{payoutOptionId}}\",\n  \"payoutDetails\": {\n    \"upiId\": \"{{upiId}}\"\n  },\n  \"idempotencyKey\": \"{{duplicateIdempotencyKey}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/withdrawals",
            "description": "Run immediately after the previous request. The same user + same idempotency key should return the existing withdrawal, not create a second debit."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retry returns the original withdrawal', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.withdrawal._id).to.eql(pm.collectionVariables.get('idempotentWithdrawalId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Negative test - invalid payout option",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"{{payoutMethod}}\",\n  \"optionId\": \"definitely-invalid-option\",\n  \"payoutDetails\": {\n    \"upiId\": \"{{upiId}}\"\n  },\n  \"idempotencyKey\": \"{{$guid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/withdrawals",
            "description": "Expected: HTTP 400 with an invalid payout option message. Use a test user; this request should not deduct VES."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid payout option is rejected', function () {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().success).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Negative test - client attempts to alter required VES",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"{{payoutMethod}}\",\n  \"optionId\": \"{{payoutOptionId}}\",\n  \"amount\": 999999,\n  \"payoutDetails\": {\n    \"upiId\": \"{{upiId}}\"\n  },\n  \"idempotencyKey\": \"{{$guid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/withdrawals",
            "description": "Demonstrates that a client-supplied amount is ignored. Run only against a disposable test user with enough test VES. Expected created withdrawal.currencyAmount must equal the database option requiredAmount saved by Get payout options; this request does create a real test withdrawal and debit."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Server uses configured option amount, not client amount', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    const data = pm.response.json();",
                  "    pm.expect(Number(data.withdrawal.currencyAmount)).to.eql(Number(pm.collectionVariables.get('requiredAmount')));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
