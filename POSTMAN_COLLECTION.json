{
  "info": {
    "name": "VELoop Rewards Wallet & Payout API",
    "description": "Postman collection for the VELoop Rewards Wallet demonstration API. Start with USER/ADMIN login to populate JWT variables. Default baseUrl points to the deployed demo backend; change it to http://localhost:5000/api for local testing. Use demo accounts and test-only UPI details. Do not export real credentials or tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://veloop-wallet-backend.onrender.com/api",
      "type": "string"
    },
    {
      "key": "userEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "userPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "payoutMethod",
      "value": "upi",
      "type": "string"
    },
    {
      "key": "payoutOptionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "payoutAmount",
      "value": "",
      "type": "string"
    },
    {
      "key": "requiredAmount",
      "value": "",
      "type": "string"
    },
    {
      "key": "upiId",
      "value": "demo@upi",
      "type": "string"
    },
    {
      "key": "withdrawalId",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminTargetUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "lastWithdrawalStatus",
      "value": "",
      "type": "string"
    },
    {
      "key": "duplicateIdempotencyKey",
      "value": "veloop-postman-idempotency-check-001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as USER",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "Enter the intended demo USER credentials in collection variables. Saves the returned JWT as userToken.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.token).to.be.a('string');",
                  "    pm.collectionVariables.set('userToken', data.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "Enter the intended demo ADMIN credentials in collection variables. Saves the returned JWT as adminToken.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.token).to.be.a('string');",
                  "    pm.collectionVariables.set('adminToken', data.token);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. User wallet and payout",
      "item": [
        {
          "name": "Get my wallet",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/wallet",
            "description": "Fetches the authenticated user wallet. Identity is derived from the JWT.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP response is successful', function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get wallet transactions (paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/wallet/transactions?page=1&limit=20",
            "description": "Fetch authenticated-user ledger entries.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
