        {
          "name": "Get withdrawal details for review",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/admin/withdrawals/{{withdrawalId}}",
            "description": "ADMIN only. This response may contain payout details; keep it private.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
